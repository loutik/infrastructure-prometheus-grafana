# ---
# Type        : Template de configuration des hosts Prometheus
# Auteur      : Louis MEDO - louis.medo@loutik.fr
# ---
# Fichier généré dynamiquement par Ansible (Rôle : pmt-gfn-install)
# ⚠️ Toute modification manuelle sera écrasée. ⚠️
# ---
---

{% for target in pmt_targets %}
{% if target.group in groups %}
{% if target.node_exporter | default(false) %}
{% for host in groups[target.group] %}
- targets:
    - '{{ hostvars[host]["ansible_host"] }}:9100'
  labels:
    service: '{{ target.group }}'
    hostname: '{{ hostvars[host]["hostname"] | default(host) }}'
    exporter: 'node_exporter'

{% endfor %}
{% endif %}
{% endif %}
{% endfor %}